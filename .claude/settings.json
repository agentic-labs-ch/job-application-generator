{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Skill",
      "Agent",
      "mcp__github",
      "mcp__Google_Drive",
      "mcp__Google_Calendar",
      "mcp__Gmail",
      "mcp__Claude_Docs",
      "mcp__Claude_Code_Remote",
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(set)",
      "Bash(export)",
      "Bash(export -p)",
      "Bash(declare -x)",
      "Bash(git *)",
      "Bash(git push *)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git -C * push *)",
      "Bash(git -C * push --force *)",
      "Bash(git -C * push --force-with-lease *)",
      "Bash(git -C * commit-tree *)",
      "Bash(git reset --hard *)",
      "Bash(git -C * reset --hard *)",
      "Bash(git rebase *)",
      "Bash(git branch -D *)",
      "Bash(git checkout --orphan *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(python3 *)",
      "Bash(curl *)",
      "Bash(zip *)",
      "Bash(unzip *)"
    ],
    "deny": [
      "Bash(cat /proc/*/environ*)",
      "Bash(cat .env*)",
      "Read(//proc/**/environ)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "extraKnownMarketplaces": {
    "designer-skills": {
      "source": { "source": "github", "repo": "Owl-Listener/designer-skills" }
    }
  },
  "enabledPlugins": {
    "ui-design@designer-skills": true,
    "design-systems@designer-skills": true,
    "adaptive-interfaces@designer-skills": true,
    "evaluation@designer-skills": true,
    "visual-critique@designer-skills": true,
    "interaction-design@designer-skills": true,
    "prototyping-testing@designer-skills": true,
    "designer-toolkit@designer-skills": true,
    "ux-strategy@designer-skills": true,
    "design-research@designer-skills": true,
    "design-strategy@designer-skills": true,
    "accessible-content@designer-skills": true,
    "inclusive-interaction@designer-skills": true,
    "inclusive-personas@designer-skills": true,
    "model-interaction-design@designer-skills": true
  }
}
